{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Start API",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend/src",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "wintop-api",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Uvicorn running on"
        }
      },
      "presentation": {
        "group": "wintop-dev",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Dev: Start frontend",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "args": ["--", "--hostname", "0.0.0.0"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "wintop-frontend",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Ready in"
        }
      },
      "presentation": {
        "group": "wintop-dev",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Dev: Start app",
      "dependsOn": ["Dev: Start API", "Dev: Start frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
