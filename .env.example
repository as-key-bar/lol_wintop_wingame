MYSQL_DATABASE=wintop
MYSQL_USER=wintop
MYSQL_PASSWORD=local_only_password
MYSQL_ROOT_PASSWORD=local_root_password
MYSQL_PORT=3306

DATABASE_URL=mysql+pymysql://wintop:local_only_password@127.0.0.1:3306/wintop

# Optional: Google login for editors (saving the build and waves). Leave empty to disable saving.
# For local testing use http://localhost:3000 and add http://localhost:3000/api/v1/auth/google/callback
# as a redirect URI on the Google OAuth client.
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=

# Days to keep YouTube-derived rows before deletion (policy limit: 30).
YOUTUBE_DATA_RETENTION_DAYS=21
