# Copy to deploy/.env on the server (chmod 600). deploy/.env is Git-ignored.
# Replace every CHANGE_ME value; generate secrets with:  openssl rand -base64 24

# Domain name for automatic HTTPS (e.g. wintop.example.com). Use ":80" for HTTP only (no domain yet).
# The DNS A record must already point at this server, or the certificate request fails.
SITE_ADDRESS=:80
# Optional: the www host that redirects to SITE_ADDRESS (needs its own A record), e.g. www.wintop.example.com. Leave empty to skip.
WWW_HOST=

MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Leave empty when the browser and API share one origin (the default setup).
CORS_ALLOW_ORIGINS=

# Enables PUT /api/v1/matchups/{p}/{o}/metadata. Empty disables it.
# Google login for editors (viewing and upvoting need no login). Leave empty to disable saving.
# PUBLIC_BASE_URL is the site's own origin with no trailing slash, e.g. https://wintop.example.com
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google addresses that are always admins (they approve other editors).
ADMIN_EMAILS=

# YouTube Data API v3 key (recommended in production). Empty falls back to HTML parsing.
YOUTUBE_API_KEY=

# Scales the per-IP request limits (1 = default, 0 = disabled). Leave at 1 in production.
RATE_LIMIT_MULTIPLIER=1

# How long YouTube-derived rows (video titles, channels, extracted builds, and their votes) are
# kept before deletion. The YouTube API policy allows 30 days at most; larger values are capped.
YOUTUBE_DATA_RETENTION_DAYS=21
