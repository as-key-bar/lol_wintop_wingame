# One origin for browser traffic: /api/* goes to FastAPI, everything else to Next.js.
# {$SITE_ADDRESS} is a domain name (automatic HTTPS) or ":80" for HTTP only.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Reject oversized request bodies before they reach the API (all JSON payloads are small).
	request_body {
		max_size 64KB
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
